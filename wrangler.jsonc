{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "budget-receipttracker",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API calls go to the Worker; everything else is the app itself
    "run_worker_first": ["/api/*", "/share"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "budget-db",
      "database_id": "d016f1c1-288c-4d1e-9d49-e21d338e2ab9",
      "migrations_dir": "migrations"
    }
  ],
  // Receipt photos (kept forever, linked to each receipt)
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "budget-receipt-images" }],
  // Fetch exchange rates every day at 06:15 and 14:15 Harare time (04:15 / 12:15 UTC)
  "triggers": { "crons": ["15 4,12 * * *"] },
  "vars": {
    // Change to claude-sonnet-5-5 if people report bad readings (see docs/SETUP.md)
    "EXTRACT_MODEL": "claude-haiku-5-5",
    // Users pay Anthropic's cost times this number for each reading
    "MARKUP": "20",
    // Free reading credit for every new account, in USD
    "FREE_CREDIT_USD": "5",
    // Who people contact to top up, and the tap-to-chat link shown with it
    "SUPPORT_CONTACT": "WhatsApp 0772 327 459",
    "SUPPORT_LINK": "https://wa.me/263772327459"
  }
  // Secret (not in this file): ANTHROPIC_API_KEY — set with `npx wrangler secret put ANTHROPIC_API_KEY`
}
