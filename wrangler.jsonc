{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "budget-receipttracker",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API calls go to the Worker; everything else is the app itself
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "budget-db",
      // Fill in after `npx wrangler d1 create budget-db` (see docs/SETUP.md)
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Receipt photos (kept forever, linked to each receipt)
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "budget-receipt-images" }],
  // Fetch exchange rates every day at 06:15 and 14:15 Harare time (04:15 / 12:15 UTC)
  "triggers": { "crons": ["15 4,12 * * *"] },
  "vars": {
    // Change to claude-sonnet-5-5 if people report bad readings (see docs/SETUP.md)
    "EXTRACT_MODEL": "claude-haiku-5-5"
  }
  // Secret (not in this file): ANTHROPIC_API_KEY — set with `npx wrangler secret put ANTHROPIC_API_KEY`
}
